# Copy to .env and fill in to enable the AI Enhance (HuggingFace) button.
# Free token: https://huggingface.co/settings/tokens
HF_TOKEN=
# Optional: override the default super-resolution model.
# HF_MODEL=caidas/swin2SR-classical-sr-x2-64

# Optional: enables the AI Enhance (Higsfield) button once you fill in
# lib/higsfield.js with Higsfield's actual API contract.
HIGSFIELD_API_URL=
HIGSFIELD_API_KEY=

PORT=3000
